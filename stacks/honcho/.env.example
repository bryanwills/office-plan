# Copied to /opt/stacks/honcho/.env (never commit the real file).
# These are not cloud keys. Ollama accepts any non-empty string.

OLLAMA_API_KEY=ollama
OPENAI_API_KEY=ollama
LLM_OPENAI_API_KEY=ollama

# Deriver on Ollama often lacks OpenAI json_schema. Force loose JSON.
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object

# Hermes "API key" is a Honcho JWT. Off until you mint one:
#   bash scripts/ai-nuc/honcho-mint-hermes-key.sh
# AUTH_USE_AUTH=true
# AUTH_JWT_SECRET=
