# Copy to /opt/stacks/onedev/.env on the server. Never commit the real file.
# initial_* is first-boot only. Changing these later does not rotate the admin.

INITIAL_USER=bryan
INITIAL_PASSWORD=change-me-generate-on-server
INITIAL_EMAIL=admin@bryanwills.dev
INITIAL_SERVER_URL=https://onedev.bryanwills.dev
INITIAL_SSH_ROOT_URL=ssh://onedev.bryanwills.dev:6611
